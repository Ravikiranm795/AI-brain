  "bin": {
    "brain": "./bin/brain.js"
  },
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "open": "^10.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "xxhash-wasm": "^1.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
