{
  "name": "project-brain",
  "version": "1.0.0",
  "description": "A persistent, incremental code-intelligence 'brain' for AI coding agents (Claude Code, Amazon Q, etc). Builds a queryable symbol graph + local vector index per repo so agents never have to re-scan the whole project.",
